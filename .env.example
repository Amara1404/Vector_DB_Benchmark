# Resource budget given to EACH engine container (and to the bench container,
# where FAISS runs). Keep them equal so the comparison is fair.
ENGINE_CPUS=4
ENGINE_MEM=16g

# Postgres memory settings (keep shared_buffers <= ~25-40% of ENGINE_MEM)
PG_SHARED_BUFFERS=4GB
PG_MWM=4GB

# Host port for the pgvector container. Default avoids 5432, since Windows
# machines very often already have a local Postgres install bound to it
# (e.g. via Anaconda) -- connecting to 5432 would silently hit that instead
# of the container and fail with a password error.
PG_HOST_PORT=5433
